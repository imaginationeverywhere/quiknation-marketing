{
  "name": "quiknation-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "pages:build": "pnpm dlx vercel build && node -e \"const fs=require('fs');const p='.vercel/output/functions/_error.func';try{fs.rmSync(p,{recursive:true,force:true});console.log('Removed _error.func (allows _not-found to be auto-ignored by adapter)');}catch(e){console.log('_error.func not found, skipping');}\" && node_modules/.bin/next-on-pages --skip-build",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@clerk/nextjs": "^6.33.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.2",
    "@cloudflare/next-on-pages": "^1.13.12"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
